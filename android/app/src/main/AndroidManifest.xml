<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ : l'affichage des notifications est refuse tant que
         l'utilisateur n'a pas donne son accord. La demande est faite au
         lancement par push_service.dart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Position du chantier : le bouton « Utiliser ma position » du
         formulaire de demande remplit la latitude et la longitude.
         FINE et non COARSE : COARSE situe a 1-3 km pres, ce qui ne
         designe pas un chantier.
         La permission est demandee A L'USAGE, jamais au lancement -
         voir core/services/service_position.dart. Le formulaire reste
         utilisable sans elle, les deux champs se saisissant a la main. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Le materiel de localisation n'est PAS requis pour utiliser l'appli.

         Google Play applique une regle implicite : declarer
         ACCESS_FINE_LOCATION revient a exiger la puce GPS, et le magasin
         retire alors l'application des appareils qui n'en ont pas — les
         tablettes Wi-Fi, typiquement. C'est ce qui s'est produit au depot
         du build 7 : six appareils compatibles avec la version precedente
         ont disparu, sans qu'aucune ligne du manifeste ne le demande.

         La declarer facultative n'est pas un contournement, c'est exact :
         `service_position.dart` traite l'absence de service, le refus de
         permission et le delai depasse comme un meme cas, et le formulaire
         reste utilisable — la latitude et la longitude se saisissent a la
         main. Un chantier a souvent le ciel bouche de toute facon.

         Meme raisonnement pour l'empreinte digitale : le verrou biometrique
         est une OPTION des reglages, jamais une condition d'usage. -->
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <uses-feature android:name="android.hardware.fingerprint" android:required="false"/>
    <application
        android:label="Widjila"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Push FCM : apparence des alertes affichees par le SYSTEME, quand
             l'application est en arriere-plan ou fermee. Sans ces trois
             entrees, Android utilise l'icone de l'application en blanc sur
             blanc — souvent invisible dans la barre d'etat. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/couleur_notification" />
        <!-- Doit rester aligne sur le canal cree dans push_service.dart ET sur
             le channelId envoye par le back (notification.service.js). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="suivi_chantier_alertes" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
